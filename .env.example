# PostgreSQL connection string. Neon pooled URLs and standard PostgreSQL URLs are supported.
DATABASE_URL=postgresql://user:password@localhost:5432/monetplane

# Base64-encoded 32-byte installation key used to encrypt provider credentials at rest.
# Generate one with: openssl rand -base64 32
MONETPLANE_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# JWT signing secret for console (NextAuth) sessions. Required for `next build`
# and at runtime; there is no placeholder fallback.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-byte-secret

# Shared secret for protected cron endpoints (/api/cron/*), e.g. the credit
# bucket expiry job. Callers send `Authorization: Bearer <CRON_SECRET>`.
# Unset or wrong secret => 401 (fail closed). Generate one with:
#   openssl rand -base64 32
CRON_SECRET=replace-with-random-32-byte-secret

# Host-only read controls (#127 transitional).
# Trust x-forwarded-for ONLY behind a proxy that overwrites it (Vercel etc.).
# Plain Node / self-host: leave unset — all host-only clients then share one
# bucket per application (rotating the header must not mint buckets).
# MONETPLANE_TRUST_PROXY=true
# MONETPLANE_HOST_READ_LIMIT=60          # positive integer, per app+client per minute
# MONETPLANE_HOST_READ_MAX_WINDOWS=10000 # hard cap; limiter fails closed when full
