# PostgreSQL connection string. Neon pooled URLs and standard PostgreSQL URLs are supported.
DATABASE_URL=postgresql://user:password@localhost:5432/monetplane

# Base64-encoded 32-byte installation key used to encrypt provider credentials at rest.
# Generate one with: openssl rand -base64 32
MONETPLANE_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# JWT signing secret for console (NextAuth) sessions. Required for `next build`
# and at runtime; there is no placeholder fallback.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-byte-secret
